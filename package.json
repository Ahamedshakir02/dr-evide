{
  "name": "dr-evide",
  "version": "0.2.0",
  "private": true,
  "description": "Dr Evide — find the right doctor near you. Symptom-to-specialty routing + trust-ranked doctor discovery for Kerala.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dr-evide/web",
    "build": "npm run build --workspace @dr-evide/web",
    "start": "npm run start --workspace @dr-evide/web",
    "mobile": "npm run start --workspace @dr-evide/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:integrity": "node scripts/check-no-paid-ranking.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "og": "node scripts/generate-og.mjs",
    "verify": "npm run check:integrity && npm run typecheck && npm run lint && npm run test",
    "db:setup": "node packages/db/setup.mjs",
    "db:seed": "node packages/db/seed.mjs",
    "notify:export": "node packages/db/export-notifications.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
