# Copy to .env.local and fill in.

# Postgres connection (optional in dev — app falls back to bundled sample data if unset)
DATABASE_URL=postgres://drevide:drevide@localhost:5432/drevide

# Anthropic API key for LLM symptom routing (optional — falls back to keyword matcher if unset)
ANTHROPIC_API_KEY=

# Shared store for the /api/route-symptom rate limiter. Optional in development:
# unset, the limit is enforced in process, which is per instance and resets on
# deploy. REQUIRED before running more than one replica — without it each one
# grants a caller the full quota. `docker compose up -d` starts one on :6379.
REDIS_URL=redis://localhost:6379

# Public origin. robots.txt and sitemap.xml must emit absolute URLs, and canonical
# links are resolved against it. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Offer the Malayalam interface. Leave unset (off) until a native speaker has
# reviewed the translations, starting with the emergency copy.
NEXT_PUBLIC_ENABLE_MALAYALAM=

# Public contact address, shown on the landing page and used as the fallback when
# the launch-notification list has no database behind it. Leave blank and the
# site shows no email address rather than a dead one.
NEXT_PUBLIC_CONTACT_EMAIL=
