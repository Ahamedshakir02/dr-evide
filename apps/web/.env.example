# Copy to .env.local and fill in.

# Postgres + PostGIS connection. Optional in development (the app falls back to
# bundled sample data). REQUIRED in production: with NODE_ENV=production and no
# DATABASE_URL, every doctor query answers 503 and /api/health reports
# "unconfigured" — the site no longer serves fictional doctors by accident.
DATABASE_URL=postgres://drevide:drevide@localhost:5432/drevide

# Set to true for managed Postgres whose URL does not already carry sslmode=require.
DATABASE_SSL=

# Max connections per app instance (default 10). Lower it on small managed plans.
DATABASE_POOL_MAX=

# Production only: serve the fictional sample doctors anyway. For a preview
# deployment someone has deliberately asked for; never on the public site.
ALLOW_SAMPLE_DATA=

# Anthropic API key for LLM symptom routing (optional — falls back to keyword matcher if unset)
ANTHROPIC_API_KEY=

# Shared store for the /api/route-symptom rate limiter. Optional in development:
# unset, the limit is enforced in process, which is per instance and resets on
# deploy. REQUIRED before running more than one replica — without it each one
# grants a caller the full quota. `docker compose up -d` starts one on :6379.
REDIS_URL=redis://localhost:6379

# Public origin. robots.txt and sitemap.xml must emit absolute URLs, and canonical
# links are resolved against it. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Offer the Malayalam interface. Leave unset (off) until a native speaker has
# reviewed the translations, starting with the emergency copy.
NEXT_PUBLIC_ENABLE_MALAYALAM=

# Public contact address, shown on the landing page and used as the fallback when
# the launch-notification list has no database behind it. Leave blank and the
# site shows no email address rather than a dead one.
NEXT_PUBLIC_CONTACT_EMAIL=

# Direct (non-pooled) connection for migrations and the admin scripts. Optional:
# falls back to DATABASE_URL. Neon's Vercel integration sets it for you.
DATABASE_URL_UNPOOLED=

# Vercel only: run db:migrate + db:seed on preview deploys too. Leave unset unless
# Preview has its own database; never point a preview at the production one.
MIGRATE_ON_PREVIEW=
