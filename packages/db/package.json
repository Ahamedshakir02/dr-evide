{
  "name": "@dr-evide/db",
  "version": "0.2.0",
  "private": true,
  "description": "Schema, migrations, and the doctor query layer. Falls back to bundled sample data when DATABASE_URL is unset.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema.sql": "./schema.sql"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "setup": "node setup.mjs",
    "seed": "node seed.mjs"
  },
  "dependencies": {
    "@dr-evide/core": "*",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.3"
  }
}
